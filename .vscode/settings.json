{
  "pylint.args": [
    "--extension-pkg-whitelist=PySide6",
    "--disable=method-hidden,E0402,W0718,C0301,E0611,C0114,C0115,C0116"
  ],
  "python.analysis.exclude": [
    ".buildozer",
    "bin",
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    ".venv"
  ],
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(notebook-move-down) Build",
      "tooltip": "🛠️ Build the app",
      "tasks": [
        {
          "label": "Build App",
          "task": "Build App",
          "description": "$(notebook-move-down) Build APK with buildozer"
        },
        {
          "label": "Clean Build",
          "task": "Clean Build",
          "description": "$(notebook-delete-cell) Clean then rebuild APK"
        }
      ]
    },
    {
      "label": "$(testing-run-icon) Run",
      "tooltip": "▶️ Run the app",
      "tasks": [
        {
          "label": "Run App",
          "task": "Run App",
          "description": "$(testing-run-icon) Run app on desktop"
        },
        {
          "label": "Run Hot Reload",
          "task": "Run Hot Reload",
          "description": "$(debug-rerun) Run app with hot reload enabled"
        }
      ]
    },
    {
      "label": "$(desktop-download) Deploy",
      "task": "Install & Run on Phone (Logcat)",
      "tooltip": "📲 Build, install and run on phone with logcat"
    },
    {
      "label": "$(gear) Setup",
      "task": "Initialize Buildozer Spec",
      "tooltip": "⚙️ Initialize buildozer.spec if not present"
    }
  ]
}
